# ==========================================
# Dependencies
# ==========================================
node_modules/
.pnp
.pnp.js

# ==========================================
# Build & Distribution Outputs
# ==========================================
# Large compiled binaries and installers (cannot be pushed to GitHub)
release/
out/
dist/
# build/ holds installer inputs that ARE kept: the fonts, the NSIS script, the icon.
build/*
!build/fonts/
!build/installer.nsh
!build/icon.png
.next/
.preview/

# TypeScript build cache
*.tsbuildinfo

# ==========================================
# Native Modules & Platform Binary Caches
# ==========================================
.native-cache/

# ==========================================
# Local Development & Temporary Scratch Data
# ==========================================
# Development PCs, simulated pen drive and fake cloud (runtime cache)
.dev-data/
.scratch/
*.backup
.package.json.backup

# ==========================================
# Database Lock & Journal Files
# Note: prisma/dev.db and database files are tracked and pushed.
# Only transient runtime lock/wal files are ignored.
# ==========================================
*.db-journal
*.db-shm
*.db-wal
*.sqlite3-journal

# ==========================================
# AI & Assistant Local Configuration
# ==========================================

# ==========================================
# Logs & Diagnostic Files
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# Python Bytecode (tools/)
# ==========================================
__pycache__/
*.py[cod]
*$py.class

# ==========================================
# Operating System & Editor Files
# ==========================================
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~
