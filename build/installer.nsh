; SMC Accounts - installs the Gujarati fonts the reports use.
; GENERATED by scripts/installer-fonts.py from build/fonts/ - edit that, not this.
;
; Fonts go to the installing user's own font folder (Windows 10 1809 and
; later), registered under HKCU, so no administrator rights are needed - the
; app itself installs per user too. A font already there is left as it is: it
; may be open in Excel, and replacing a font in use fails. Uninstalling the
; app leaves the fonts, because documents made with them still need them.

!define SMC_FONT_DIR "$LOCALAPPDATA\Microsoft\Windows\Fonts"
!define SMC_FONT_KEY "Software\Microsoft\Windows NT\CurrentVersion\Fonts"

!macro SmcInstallFont FILE NAME
  SetOutPath "${SMC_FONT_DIR}"
  SetOverwrite off
  File "${BUILD_RESOURCES_DIR}\fonts\${FILE}"
  SetOverwrite on
  WriteRegStr HKCU "${SMC_FONT_KEY}" "${NAME} (TrueType)" "${SMC_FONT_DIR}\${FILE}"
  ; Make it usable at once, without logging off.
  System::Call 'gdi32::AddFontResource(t "${SMC_FONT_DIR}\${FILE}") i .s'
  Pop $0
!macroend

!macro customInstall
  DetailPrint "Installing the Gujarati fonts..."
  CreateDirectory "${SMC_FONT_DIR}"
  !insertmacro SmcInstallFont "AnekGujarati-Bold.ttf" "Anek Gujarati Bold"
  !insertmacro SmcInstallFont "AnekGujarati-Regular.ttf" "Anek Gujarati Regular"
  !insertmacro SmcInstallFont "BalooBhai2-Bold.ttf" "Baloo Bhai 2 Bold"
  !insertmacro SmcInstallFont "BalooBhai2-Regular.ttf" "Baloo Bhai 2 Regular"
  !insertmacro SmcInstallFont "Farsan-Regular.ttf" "Farsan Regular"
  !insertmacro SmcInstallFont "HindVadodara-Bold.ttf" "Hind Vadodara Bold"
  !insertmacro SmcInstallFont "HindVadodara-Medium.ttf" "Hind Vadodara Medium"
  !insertmacro SmcInstallFont "HindVadodara-Regular.ttf" "Hind Vadodara Regular"
  !insertmacro SmcInstallFont "HindVadodara-SemiBold.ttf" "Hind Vadodara SemiBold"
  !insertmacro SmcInstallFont "KumarOne-Regular.ttf" "Kumar One Regular"
  !insertmacro SmcInstallFont "KumarOneOutline-Regular.ttf" "Kumar One Outline"
  !insertmacro SmcInstallFont "Mogra-Regular.ttf" "Mogra Regular"
  !insertmacro SmcInstallFont "MuktaVaani-Bold.ttf" "Mukta Vaani Bold"
  !insertmacro SmcInstallFont "MuktaVaani-Medium.ttf" "Mukta Vaani Medium"
  !insertmacro SmcInstallFont "MuktaVaani-Regular.ttf" "Mukta Vaani Regular"
  !insertmacro SmcInstallFont "MuktaVaani-SemiBold.ttf" "Mukta Vaani SemiBold"
  !insertmacro SmcInstallFont "NotoSansGujarati-Bold.ttf" "Noto Sans Gujarati Bold"
  !insertmacro SmcInstallFont "NotoSansGujarati-Regular.ttf" "Noto Sans Gujarati Regular"
  !insertmacro SmcInstallFont "NotoSerifGujarati-Bold.ttf" "Noto Serif Gujarati Bold"
  !insertmacro SmcInstallFont "NotoSerifGujarati-Regular.ttf" "Noto Serif Gujarati Regular"
  !insertmacro SmcInstallFont "Rasa-Bold.ttf" "Rasa Bold"
  !insertmacro SmcInstallFont "Rasa-Regular.ttf" "Rasa Regular"
  !insertmacro SmcInstallFont "Shrikhand-Regular.ttf" "Shrikhand Regular"
  ; Tell programs already running that new fonts are here.
  SendMessage ${HWND_BROADCAST} ${WM_FONTCHANGE} 0 0 /TIMEOUT=5000
  ; Back where the app's own files go.
  SetOutPath "$INSTDIR"
!macroend
